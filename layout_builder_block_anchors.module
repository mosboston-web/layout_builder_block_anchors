<?php

/**
 * @file
 * Primary module hooks for Layout Builder Block Anchors module.
 */

use Drupal\Component\Utility\Html;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Link;
use Drupal\Core\Url;
use Drupal\node\Entity\Node;

/**
 * Implements hook_form_FORM_ID_alter().
 *
 * Adds a block anchor link to the layout builder block configuration form.
 */
function layout_builder_block_anchors_form_layout_builder_update_block_alter(array &$form, FormStateInterface $form_state) {
  $block_id = $form['settings']['block_form']['#block']->id() ?? NULL;
  // Used because blocks from older Drupal versions can be missing ID.
  $block_uuid = $form['settings']['block_form']['#block']->uuid() ?? NULL;
  // URLs like: /layout_builder/update/block/overrides/node.441/0/content/...
  $current_url = \Drupal::service('path.current')->getPath();
  if ($block_id && strpos($current_url, '/node.') !== FALSE) {
    $parts = explode('node.', $current_url);
    // Trimming tail of URL by casting to int.
    $nid = isset($parts[1]) ? (int) $parts[1] : 0;
    if ($nid) {
      $node = Node::load($nid);
      if ($node) {
        $bundle = $node->bundle();
        // Load the default layout for this bundle.
        $display = \Drupal::entityTypeManager()
          ->getStorage('entity_view_display')
          ->load('node.' . $bundle . '.default');
        $default_uuids = [];
        if ($display && method_exists($display, 'getSections')) {
          foreach ($display->getSections() as $section) {
            foreach ($section->getComponents() as $component) {
              $configuration = $component->get('configuration');
              $default_uuid = $configuration['block_uuid'] ?? NULL;
              if (!empty($default_uuid)) {
                $default_uuids[] = $default_uuid;
              }
            }
          }
        }
        if (in_array($block_uuid, $default_uuids)) {
          $link_info = t('This is a default block. Re-save this block and the page layout if you need an anchor link for this block.');
        }
        else {
          // Checking front to avoid links with /home in them.
          $front = \Drupal::config('system.site')->get('page.front');
          if ($front === '/node/' . $nid) {
            $url_object = Url::fromRoute('<front>', [], ['absolute' => TRUE]);
          }
          else {
            $url_object = $node->toUrl('canonical', ['absolute' => TRUE]);
          }
          $url_object->setOption('fragment', Html::cleanCssIdentifier(layout_builder_block_anchors_prefix() . $block_id));
          $url_with_anchor = $url_object->toString();
          $link_info = Link::fromTextAndUrl($url_with_anchor, $url_object)->toString();
        }
        $form['anchor_link'] = [
          '#type' => 'markup',
          '#markup' => '<div class="layout-builder-block-anchor-link"><strong>' . t('Block Anchor Link:') . '</strong> ' . $link_info . '</div>',
          '#weight' => -100,
        ];
      }
    }
  }
}

/**
 * Implements hook_preprocess_block().
 *
 * Adds an anchor ID to layout builder inline blocks.
 */
function layout_builder_block_anchors_preprocess_block(array &$variables) {
  $block_type = $variables['base_plugin_id'] ?? '';
  if ($block_type === 'inline_block') {
    if (!isset($variables['content']['#block_content'])) {
      return;
    }
    $block_id = $variables['content']['#block_content']?->id() ?? NULL;
    if ($block_id) {
      $anchor_id = layout_builder_block_anchors_prefix() . $block_id;
      // title_prefix is a reliable way to anchor to the top of the block.
      if (!isset($variables['title_prefix']) || !is_array($variables['title_prefix'])) {
        $variables['title_prefix'] = [];
      }
      $variables['title_prefix']['layout_builder_block_anchor'] = [
        '#type' => 'html_tag',
        '#tag' => 'span',
        '#attributes' => [
          'id' => Html::cleanCssIdentifier($anchor_id),
        ],
        '#weight' => -100,
      ];
    }
  }
}

/**
 * Returns the anchor prefix for layout builder block anchors.
 */
function layout_builder_block_anchors_prefix() {
  return 'block-';
}
